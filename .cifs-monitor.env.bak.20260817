# Config สำหรับ push-monitors-cifs.sh
# ⚠️ ไฟล์นี้มี Push token (secret) — permission 600 อ่านได้เฉพาะ owner เท่านั้น
# หมายเหตุ: KUMA_BASE ใช้ domain สาธารณะ (ผ่าน NPM proxy) — ถ้าต้องการใช้ LAN ตรง
#   ให้เปลี่ยนเป็น http://192.168.10.9:3001/api/push (เร็วกว่า ไม่ผ่าน proxy)

# Uptime Kuma Push API base URL (ไม่มี trailing slash)
KUMA_BASE="https://uptime.np-dms.work/api/push"

# curl timeout ต่อ request (วินาที) — ป้องกัน cron ค้าง
CURL_TIMEOUT="5"

# mounts ที่ต้องตรวจสอบ (คั่นด้วย space) — ตรงกับ /etc/fstab
MOUNTS="/mnt/asustor-uploads/temp /mnt/asustor-uploads/permanent /mnt/asustor-legacy"

# mounts ที่ backend เขียนได้ (ตรวจ write permission เพิ่ม) — ไม่รวม legacy (read-only)
WRITABLE_MOUNTS="/mnt/asustor-uploads/temp /mnt/asustor-uploads/permanent"

# Token mapping — Push token จริงจาก Uptime Kuma (สร้างใน UI ก่อน)
# รูปแบบ: <mount-path>=<token> บรรทัดละ entry (อ้างอิง MONITORING-PLAN-REV01.md §5)
#   - สร้าง: 2026-07-31
#   - หากสร้าง monitor ใหม่/ลบ ต้องอัปเดต mapping นี้ให้ตรง
TOKEN_MAP="/mnt/asustor-uploads/temp=AzFTvydTq64aoykYu9714FDjkYGXomTA
/mnt/asustor-uploads/permanent=4a3ZQakOxTpoLEJvfE5AQg82hKhiNB3F
/mnt/asustor-legacy=VwOnDWeBjFLuYRh3ejJLwxofn7UU7Mtk"
