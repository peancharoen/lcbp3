    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Fix 2: ป้องกัน Loop History Pollution\n// $('Process Batch + Encoding') เป็น PRIMARY source เพราะ:\n//   1. รันทุก iteration (เป็น loop entry point)\n//   2. มี original_index เสมอ\n// $('Parse & Validate AI Response') ถูกถอดออกเพราะไม่รันใน error paths\n//   (เช่น file not found, upload failed) → จะคืนข้อมูลจาก iteration ก่อนหน้า (stale)\n// $input.first().json ใช้สำหรับ terminal_outcome และ route_index เท่านั้น\n//   เพราะ HTTP nodes แทนที่ JSON ทั้งหมดด้วย response\n\nconst currentItem = $json || {};\nconst config = $('Set Configuration').first().json.config;\n\n// PRIMARY: Process Batch + Encoding — รันทุก iteration, มี metadata ครบ\nlet meta = {};\ntry {\n  meta = $('Process Batch + Encoding').first()?.json || {};\n} catch (_) {\n  // ถ้าเข้าถึงไม่ได้ ใช้ currentItem เป็น fallback\n  meta = currentItem;\n}\n\nconst originalIndex = Number(meta.original_index);\nif (!Number.isInteger(originalIndex) || originalIndex < 0) {\n  throw new Error(`CHECKPOINT_METADATA_MISSING: original_index unavailable — currentItem: ${JSON.stringify(currentItem).substring(0, 200)}`);\n}\n\n// terminal_outcome มาจาก currentItem (ซึ่งอาจเป็น HTTP response หรือ Code node output)\n// ถ้า currentItem มี route_index ใช้สิ่งนั้น, ถ้าไม่มีตรวจจาก meta\nconst routeIndex = currentItem.route_index ?? meta.route_index;\nconst hasError = currentItem.error || currentItem.parse_error || meta.error || meta.parse_error;\nconst terminalOutcome = routeIndex === 2 ? 'REJECTED' : (hasError ? 'FAILED' : 'QUEUED');\n\nreturn { json: {\n  batch_id: meta.batch_id || config.BATCH_ID,\n  original_index: originalIndex,\n  next_index: originalIndex + 1,\n  row_key: meta.row_key || '',\n  document_number: meta.document_number || currentItem.document_number || 'UNKNOWN',\n  terminal_outcome: terminalOutcome,\n} };"
      },
      "id": "v4-prepare-checkpoint",
      "name": "Prepare Terminal Checkpoint",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -9664,
        6600
      ],
      "notes": "Fix 2: ใช้ $('Process Batch + Encoding') เป็น PRIMARY source (รันทุก iteration) — ถอด $('Parse & Validate AI Response') ออกจาก candidates เพราะไม่รันใน error paths → กัน Loop History Pollution จาก iteration ก่อนหน้า"
    },
    {
      "parameters": {
        "jsCode": "// M4: RBAC scope verification (ADR-016)\n// ตรวจสอบว่า MIGRATION_TOKEN มี permission ที่จำเป็นสำหรับ workflow นี้\n// Profile response shape: { assignments: [{ role: { roleName, permissions: [{ permissionName }] } }] }\nconst profile = $json || {};\nconst REQUIRED_PERMISSIONS = ['ai.suggest'];\nconst ADMIN_ROLES = new Set(['Superadmin', 'Org Admin']);\n\n// กรณี backend คืน { data: { ... } } หรือ { ... } โดยตรง\nconst user = profile.data || profile;\nconst assignments = Array.isArray(user.assignments) ? user.assignments : [];\n\n// กรองเฉพาะ assignments ที่มี role\nconst roles = assignments\n  .map(a => a?.role?.roleName)\n  .filter(Boolean);\n\n// Superadmin ผ่านทุก permission check\nconst isAdmin = roles.some(r => ADMIN_ROLES.has(r));\n\n// รวบรวม permission ทั้งหมดจากทุก role\nconst allPermissions = new Set();\nfor (const assignment of assignments) {\n  const perms = assignment?.role?.permissions;\n  if (Array.isArray(perms)) {\n    for (const p of perms) {\n      const name = p?.permissionName || p?.name;\n      if (name) allPermissions.add(name);\n    }\n  }\n}\n\n// ตรวจสอบ required permissions\nconst missing = REQUIRED_PERMISSIONS.filter(p => !isAdmin && !allPermissions.has(p));\n\nif (missing.length > 0) {\n  const errorMsg = `UNAUTHORIZED_SCOPE: token ขาด permission ที่จำเป็น [${missing.join(', ')}] — roles: [${roles.join(', ') || 'none'}] (ADR-016)`;\n  throw new Error(errorMsg);\n}\n\nreturn [{\n  json: {\n    scope_verified: true,\n    roles: roles,\n    permissions: Array.from(allPermissions).sort(),\n    is_admin: isAdmin,\n    username: user.username || user.user_id || 'unknown',\n  }\n}];"
      },
      "id": "fb5121f7-8ea0-4972-b1e6-6a1e066d3ca8",
      "name": "Verify Migration Scope",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -10832,
        6272
      ],
      "notes": "M4: ตรวจสอบ RBAC scope จาก /api/auth/profile response — ต้องมี ai.suggest หรือเป็น Superadmin/Org Admin (ADR-016)"
    },
    {
