      },
      "id": "9741889b-95d6-4bfc-acf6-ea838242632d",
      "name": "Resolve Contract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        -10480,
        6272
      ],
      "onError": "continueErrorOutput",
      "notes": "ค้นหา Contract ด้วย contractCode ผ่าน GET /api/contracts?search=... — ถ้า contractCode เว้นว่างจะ hit /health แทน (skip)"
    },
    {
      "parameters": {
        "jsCode": "// Resolve Project/Contract Code เป็น UUIDv7 ผ่าน backend API\n// แทนการให้ผู้ใช้พิมพ์ UUID ยาวๆ ใน form\nconst formData = $('Form Trigger').first()?.json || {};\nconst projectCode = String(formData['Project Code'] || '').trim();\nconst contractCode = String(formData['Contract Code'] || '').trim();\n\n// H1: UUIDv7 format validation (ADR-019)\nconst UUID_V7_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;\nconst isUuidV7 = (s) => typeof s === 'string' && s.trim().length > 0 && UUID_V7_RE.test(s.trim());\n\n// ── Resolve Project ──────────────────────────────────────────\nconst projectResponse = $('Resolve Project').first()?.json || {};\nconst projectData = projectResponse?.data || [];\nif (!Array.isArray(projectData) || projectData.length === 0) {\n  throw new Error(`PROJECT_NOT_FOUND: ไม่พบโครงการที่ match \"${projectCode}\" — ตรวจสอบ Project Code ใน form`);\n}\n\n// กรอง exact match ที่ projectCode (search API ใช้ LIKE)\nconst projectMatch = projectData.find(p => p.projectCode === projectCode);\nif (!projectMatch) {\n  const found = projectData.map(p => p.projectCode).join(', ');\n  throw new Error(`PROJECT_NOT_FOUND: ไม่พบ exact match สำหรับ \"${projectCode}\" — ผลการค้นหา: [${found}]`);\n}\n\nconst projectPublicId = projectMatch.publicId;\nif (!isUuidV7(projectPublicId)) {\n  throw new Error(`PROJECT_UUID_INVALID: publicId ของ project \"${projectCode}\" ไม่ใช่ UUIDv7: ${projectPublicId}`);\n}\n\n// ── Resolve Contract (ถ้ามี) ─────────────────────────────────\nlet contractPublicId = null;\nif (contractCode) {\n  const contractResponse = $('Resolve Contract').first()?.json || {};\n  const contractData = contractResponse?.data || [];\n  if (!Array.isArray(contractData) || contractData.length === 0) {\n    throw new Error(`CONTRACT_NOT_FOUND: ไม่พบสัญญาที่ match \"${contractCode}\" — ตรวจสอบ Contract Code ใน form`);\n  }\n\n  // กรอง exact match ที่ contractCode\n  const contractMatch = contractData.find(c => c.contractCode === contractCode);\n  if (!contractMatch) {\n    const found = contractData.map(c => c.contractCode).join(', ');\n    throw new Error(`CONTRACT_NOT_FOUND: ไม่พบ exact match สำหรับ \"${contractCode}\" — ผลการค้นหา: [${found}]`);\n  }\n\n  contractPublicId = contractMatch.publicId;\n  if (!isUuidV7(contractPublicId)) {\n    throw new Error(`CONTRACT_UUID_INVALID: publicId ของ contract \"${contractCode}\" ไม่ใช่ UUIDv7: ${contractPublicId}`);\n  }\n}\n\nreturn [{\n  json: {\n    projectPublicId: projectPublicId,\n    contractPublicId: contractPublicId,\n    projectName: projectMatch.projectName || '',\n    contractName: contractMatch?.contractName || '',\n  }\n}];"
      },
      "id": "d72e2bd0-e7a3-4803-9dca-61f4a8b863c6",
      "name": "Set Resolved UUIDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -10320,
        6272
      ],
      "notes": "Resolve Project/Contract Code → UUIDv7 ผ่าน backend API + exact match + UUIDv7 validation (ADR-019)"
    }
  ],
