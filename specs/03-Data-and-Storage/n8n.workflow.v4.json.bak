    },
    {
      "parameters": {
        "url": "={{ $('Form Trigger').first().json['Contract Code'] ? $('Set Configuration').first().json.config.BACKEND_URL + '/api/contracts?search=' + encodeURIComponent($('Form Trigger').first().json['Contract Code']) + '&limit=50' : $('Set Configuration').first().json.config.BACKEND_URL + '/health' }}",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
