    },
    {
      "parameters": {
        "amount": "={{ $('Set Configuration').first().json.config.AI_JOB_POLL_INTERVAL_MS / 1000 }}",
        "unit": "seconds"
      },
      "id": "a7a331be-4b1a-4eea-aaac-ae6c306dd374",
      "name": "Wait for Poll",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1,
