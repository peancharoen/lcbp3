    },
    {
      "parameters": {
        "jsCode": "// H2: เตรียม context สำหรับ native poll loop (ไม่ใช้ while loop ใน Code node)\n// ดึง jobId จาก Submit AI Job response + metadata จาก Build AI Job Payload\nconst submitResponse = $('Submit AI Job').first()?.json || {};\nconst originalMeta = $('Build AI Job Payload').first()?.json || {};\n\nconst jobId = submitResponse?.jobId || submitResponse?.data?.jobId;\nif (!jobId) {\n  // FR-010b: ถ้า 401 → mark TOKEN_EXPIRED\n  if (submitResponse?.statusCode === 401 || submitResponse?.error?.status === 401) {\n    throw new Error('TOKEN_EXPIRED: 401 Unauthorized — กรุณา renew MIGRATION_TOKEN แล้ว resume');\n  }\n  throw new Error(`Submit AI Job failed — no jobId returned for: ${originalMeta.document_number}`);\n}\n\nreturn [{\n  json: {\n    ...originalMeta,\n    job_id: jobId,\n    poll_start_time: Date.now(),\n  }\n}];"
      },
