        "url": "={{ $('Set Configuration').first().json.config.BACKEND_URL}}/api/master/tags",
        "options": {
          "timeout": 10000
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + ($('Set Configuration').first().json.config.AUTH_TOKEN || '').replace(/^Bearer\\s+/i, '') }}"
