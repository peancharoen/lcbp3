    },
    {
      "parameters": {
        "jsCode": "// H2: เตรียม AI result จาก poll response สำหรับ downstream processing\n// อ่าน metadata จาก Prepare Poll Context (รันครั้งเดียว ไม่ใช้ loop)\nconst pollResponse = $json || {};\nconst pollContext = $('Prepare Poll Context').first()?.json || {};\n\nconst aiResult = pollResponse?.result || pollResponse?.data?.result || {};\n\nreturn [{\n  json: {\n    ...pollContext,\n    job_id: pollContext.job_id,\n    ai_result: aiResult,\n    ai_status: 'completed',\n  }\n}];"
      },
      "id": "e6e05b83-5f7f-41a5-8834-e531f46520dd",
      "name": "Prepare AI Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -9700,
        6150
      ],
      "notes": "H2: รวม metadata จาก Prepare Poll Context + ai_result จาก poll response → ส่งต่อไป Parse & Validate"
    },
    {
      "parameters": {
        "jsCode": "// H2: จัดรูปแบบ error จาก poll loop สำหรับ Log Error to CSV\n// รับ input จาก: Route Poll Status (failed/timeout) + Poll Job Status (HTTP error)\nconst pollResponse = $json || {};\nconst pollContext = $('Prepare Poll Context').first()?.json || {};\nconst config = $('Set Configuration').first().json.config;\n\nconst documentNumber = pollContext.document_number || 'UNKNOWN';\nconst jobId = pollContext.job_id || 'UNKNOWN';\n\n// ตรวจสอบ 401 token expired (จาก HTTP error output)\nconst httpStatus = pollResponse?.statusCode || pollResponse?.error?.status;\nif (httpStatus === 401) {\n  return [{\n    json: {\n      document_number: documentNumber,\n      error_type: 'API_ERROR',\n      error: `TOKEN_EXPIRED: renew MIGRATION_TOKEN and resume — document=${documentNumber}, jobId=${jobId}`,\n      job_id: jobId,\n    }\n  }];\n}\n\n// ตรวจสอบ timeout\nconst elapsed = Date.now() - (pollContext.poll_start_time || Date.now());\nif (elapsed > (config.AI_JOB_TIMEOUT_MS || 50000)) {\n  return [{\n    json: {\n      document_number: documentNumber,\n      error_type: 'API_ERROR',\n      error: `AI Job timeout after ${config.AI_JOB_TIMEOUT_MS}ms for jobId: ${jobId}, document: ${documentNumber}`,\n      job_id: jobId,\n    }\n  }];\n}\n\n// status === 'failed' หรือ HTTP error อื่นๆ\nconst failDetail = JSON.stringify(pollResponse?.error || pollResponse?.data?.error || pollResponse?.message || 'unknown');\nreturn [{\n  json: {\n    document_number: documentNumber,\n    error_type: 'API_ERROR',\n    error: `AI_JOB_FAILED: document=${documentNumber}, jobId=${jobId}, error=${failDetail}`,\n    job_id: jobId,\n  }\n}];"
      },
      "id": "9b18d120-9706-4f29-998e-3a7067ff4b55",
      "name": "Format Poll Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -9700,
        6500
      ],
      "notes": "H2: จัดรูปแบบ error จาก poll loop (failed/timeout/HTTP error) → Log Error to CSV"
    },
    {
