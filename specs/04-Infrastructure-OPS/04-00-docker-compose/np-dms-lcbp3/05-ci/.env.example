# Gitea Actions Runner — lcbp3-runner on New Server (192.168.10.11)
# Generate registration token from:
#   Gitea UI → Site Administration → Actions → Runners → Register New Runner
#   หรือ: docker exec gitea gitea admin user generate-access-token --username admin --token-name "runner-$(date +%s)" --scopes all

# Gitea connection — Docker internal DNS (co-located, latency 0)
GITEA_INSTANCE_URL=http://gitea:3000

# Registration token (จาก Gitea admin panel)
GITEA_RUNNER_REGISTRATION_TOKEN=<token>

# Runner name (แสดงใน Gitea Actions UI)
GITEA_RUNNER_NAME=lcbp3-runner
